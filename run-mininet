#!/usr/bin/env python3

# Runs a simulated network (with Mininet), connected to chirouter.
#
# Must be run as root, from the root of the chirouter directory.
#
# Usage: run-mininet TOPOLOGY_FILE [--chirouter HOST:PORT]

import os
import sys

import click

# Where chirouter is running, if --chirouter is not specified. In the
# Docker container, chirouter runs on the host machine (which the container
# can reach as host.docker.internal), and Docker creates DOCKERENV_FILE in
# the container (we use it to check whether we're running in it).
DEFAULT_CHIROUTER_HOST = "localhost"
DEFAULT_CHIROUTER_HOST_DOCKER = "host.docker.internal"
DEFAULT_CHIROUTER_PORT = 23320
DOCKERENV_FILE = "/.dockerenv"


def validate_host(ctx: click.Context, param: click.Parameter,
                  value: str | None) -> tuple[str, int] | None:
    '''
    Validates the value of the --chirouter option (click callback).

    Inputs:
      ctx (click.Context): the click context.
      param (click.Parameter): the option.
      value (str | None): the value of the option ("HOST:PORT"), or None
        if the option was not specified.

    Returns:
      (tuple of str and int | None) the host and port, or None if the
      option was not specified. Raises click.BadParameter if the value
      is not in the HOST:PORT format.
    '''
    if value is None:
        return None

    try:
        host, port = value.split(":")
        return host, int(port)
    except ValueError:
        raise click.BadParameter("Host needs to be in format HOST:PORT")


@click.command(name="run-mininet")
@click.argument('topo_file', type=click.Path(exists=True))
@click.option('--chirouter', callback=validate_host, metavar="HOST:PORT",
              help="Host and port of chirouter")
def cmd(topo_file: str, chirouter: tuple[str, int] | None) -> None:
    '''
    Runs the simulated network (see the top of this file).

    Inputs:
      topo_file (str): path to the topology file.
      chirouter (tuple of str and int | None): host and port of chirouter.

    Returns: nothing. Exits with an error if not run as root, if the
    chirouter packages cannot be imported, or if chirouter cannot be
    reached.
    '''
    if os.geteuid() != 0:
        sys.exit("Mininet must be run as root. "
                 "Please try running with 'sudo'.")

    src_path = os.path.dirname(os.path.realpath(__file__)) + '/src/python'
    sys.path.insert(0, src_path)

    try:
        import chirouter.simulator as simulator
        from chirouter.client import ChirouterNotRespondingError
    except ImportError as ie:
        print(ie)
        print("Could not import chirouter packages.")
        print("Please make sure you run this command from your "
              "chirouter directory.")
        sys.exit(1)

    if chirouter is not None:
        chirouter_host, chirouter_port = chirouter
    elif os.path.exists(DOCKERENV_FILE):
        chirouter_host = DEFAULT_CHIROUTER_HOST_DOCKER
        chirouter_port = DEFAULT_CHIROUTER_PORT
    else:
        chirouter_host = DEFAULT_CHIROUTER_HOST
        chirouter_port = DEFAULT_CHIROUTER_PORT

    try:
        simulator.run(topo_file=os.path.abspath(topo_file),
                      chirouter_host=chirouter_host,
                      chirouter_port=chirouter_port)
    except ChirouterNotRespondingError:
        print(f"chirouter (at {chirouter_host}:{chirouter_port}) accepted "
              "the connection, but did not respond.")
        print("chirouter can only be connected to one instance of Mininet "
              "at a time, so it may")
        print("already be connected to another one (e.g., in a Docker "
              "container that is still")
        print("running). If so, exit that instance of Mininet, or restart "
              "chirouter. To see the")
        print("running containers, run \"docker ps\" (outside the "
              "container), and to stop one,")
        print("run \"docker rm -f CONTAINER\" (where CONTAINER is the "
              "container's ID or name).")
        sys.exit(1)
    except OSError as ose:
        print(f"Could not connect to chirouter at {chirouter_host}:"
              f"{chirouter_port} ({ose.strerror or ose}).")
        print("Please make sure chirouter is running (if you are running "
              "it on a port other than")
        print(f"{DEFAULT_CHIROUTER_PORT}, use --chirouter HOST:PORT to "
              "specify where it is running).")
        sys.exit(1)


if __name__ == "__main__":
    cmd()
